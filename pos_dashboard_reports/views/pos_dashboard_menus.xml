<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_pos_dashboard_client" model="ir.actions.client">
        <field name="name">POS Dashboard</field>
        <field name="tag">pos_dashboard_client_action</field>
        <field name="params" eval="{'report_key': 'direksi'}"/>
    </record>

    <menuitem id="menu_pos_dashboard_root" name="POS Dashboard"
              sequence="10" groups="pos_dashboard_reports.group_pos_dashboard_user"/>

    <menuitem id="menu_pos_dashboard_main" name="Dashboard"
              parent="menu_pos_dashboard_root"
              action="action_pos_dashboard_client"
              sequence="1"/>

    <menuitem id="menu_pos_dashboard_reports" name="Laporan"
              parent="menu_pos_dashboard_root"
              action="action_pos_dashboard_report_wizard"
              sequence="2"/>

    <menuitem id="menu_pos_dashboard_config_root" name="Konfigurasi"
              parent="menu_pos_dashboard_root"
              sequence="90"
              groups="pos_dashboard_reports.group_pos_dashboard_manager"/>

    <menuitem id="menu_pos_dashboard_category_map" name="Mapping Kategori Laporan"
              parent="menu_pos_dashboard_config_root"
              action="action_pos_dashboard_category_map"
              sequence="1"/>
</odoo>
