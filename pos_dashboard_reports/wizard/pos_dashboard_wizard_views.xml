<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_dashboard_report_wizard_form" model="ir.ui.view">
        <field name="name">pos.dashboard.report.wizard.form</field>
        <field name="model">pos.dashboard.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Filter Laporan POS Dashboard">
                <group>
                    <group>
                        <field name="report_key"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="config_ids" widget="many2many_tags"/>
                        <field name="user_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view_dashboard" type="object"
                            string="Lihat Dashboard" class="btn-primary"/>
                    <button name="action_print_pdf" type="object"
                            string="Cetak PDF" class="btn-secondary"/>
                    <button name="action_export_xlsx" type="object"
                            string="Export Excel" class="btn-secondary"/>
                    <button string="Tutup" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_dashboard_report_wizard" model="ir.actions.act_window">
        <field name="name">Laporan POS Dashboard</field>
        <field name="res_model">pos.dashboard.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
